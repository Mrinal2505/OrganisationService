<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="LOG_HOME" value="log" />

    <!-- ══════════════════════════════════════════
         CONSOLE
    ══════════════════════════════════════════ -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ══════════════════════════════════════════
         TRACE LOG  →  log/trace.log
         (tracklogger — all API flow / business logic)
    ══════════════════════════════════════════ -->
    <appender name="TRACE-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/trace.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/trace.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- ══════════════════════════════════════════
         DB LOG  →  log/db.log
         (dblogger — all DB save / update / delete ops)
         (Hibernate SQL — actual queries executed)
    ══════════════════════════════════════════ -->
    <appender name="DB-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/db.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/db.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- ══════════════════════════════════════════
         LOGGER BINDINGS
    ══════════════════════════════════════════ -->

    <!-- tracklogger  →  trace.log + console -->
    <logger name="tracklogger" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="TRACE-FILE"/>
    </logger>

    <!-- dblogger  →  db.log + console -->
    <logger name="dblogger" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="DB-FILE"/>
    </logger>

    <!-- Hibernate SQL  →  db.log only (no console noise) -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="false">
        <appender-ref ref="DB-FILE"/>
    </logger>

    <!-- Hibernate bind parameters  →  db.log only -->
    <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="false">
        <appender-ref ref="DB-FILE"/>
    </logger>

    <!-- Root — only ERROR and above to console -->
    <root level="ERROR">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>