<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Root log directory: creates a "logs" folder in your project root -->
    <property name="LOG_HOME" value="${user.dir}/logs" />

    <!-- ===== Console Appender ===== -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ===== trace.log — TraceLogger (tracklogger) ===== -->
    <appender name="TRACE-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/trace.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/trace.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- ===== db.log — DBLogger (dblogger) ===== -->
    <appender name="DB-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/db.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/archived/db.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <!-- TraceLogger: routes "tracklogger" → console + trace.log -->
    <logger name="tracklogger" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="TRACE-FILE"/>
    </logger>

    <!-- DBLogger: routes "dblogger" → console + db.log -->
    <logger name="dblogger" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="DB-FILE"/>
    </logger>

    <!-- Root Logger (catches Spring/Hibernate errors) -->
    <root level="ERROR">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>